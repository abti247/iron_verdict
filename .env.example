# Server
HOST=0.0.0.0
PORT=8000

# Security — set to your domain in production (e.g. https://iron-verdict.up.railway.app)
ALLOWED_ORIGIN=*

# Sessions
SESSION_TIMEOUT_HOURS=4
DISPLAY_CAP=20
MAX_WEBSOCKETS=2000

# Rate limits per IP (raised on staging, where the E2E suite runs)
RATE_LIMIT_SESSION_CREATE=10/hour
RATE_LIMIT_SESSION_LOOKUP=30/minute
RATE_LIMIT_METRICS=30/minute
RATE_LIMIT_VPORTAL_LOGIN=10/minute
RATE_LIMIT_VPORTAL_GRAPHQL=600/minute

# Monitoring — bearer token Grafana sends to GET /metrics (e.g. `openssl rand -hex 32`).
# Leave empty to switch the endpoint off. Never commit a real token.
METRICS_TOKEN=

# Logs to Grafana Cloud Loki (production only) — a copy of every log line
# without client IPs; stdout keeps everything. Ship nothing unless all three are set.
# LOKI_URL must be https (otherwise nothing is sent) — the full push URL, e.g. https://logs-prod-XXX.grafana.net/loki/api/v1/push;
# LOKI_USER the numeric user; LOKI_TOKEN an access-policy token with logs:write only.
LOKI_URL=
LOKI_USER=
LOKI_TOKEN=

# Persistence — mount /data as a volume to survive restarts
SNAPSHOT_PATH=/data/sessions.json

# Logging
LOG_LEVEL=INFO

# App version — set by CI/CD from git tag (e.g. v1.0.0)
APP_VERSION=dev
