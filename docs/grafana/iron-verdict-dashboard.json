    {
      "type": "stat",
      "id": 6,
      "title": "Version",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (version) (iron_verdict_build_info{job=~\"$job\"})",
          "legendFormat": "{{version}}",
